{
  "name": "workbuddy-connect",
  "version": "2.2.0",
  "description": "Local WorkBuddy bridge: turns your own WorkBuddy desktop account models (free ones included) into one OpenAI Responses endpoint for ZCode and Codex CLI",
  "type": "module",
  "bin": {
    "workbuddy-connect": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "plugins",
    "marketplace.json",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/cli.ts serve",
    "status": "node src/cli.ts status",
    "accounts": "node src/cli.ts accounts",
    "models": "node src/cli.ts models --region cn",
    "test": "node --test tests/*.test.ts",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check:plugin": "node scripts/build-plugin.mjs --check",
    "setup": "node src/cli.ts install --region cn"
  },
  "keywords": [
    "workbuddy",
    "openai-compatible",
    "openai",
    "responses",
    "bridge",
    "zcode",
    "codex",
    "cli"
  ],
  "author": {
    "name": "luoxh8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luoxh8/workbuddy-connect.git"
  },
  "homepage": "https://github.com/luoxh8/workbuddy-connect#readme",
  "bugs": {
    "url": "https://github.com/luoxh8/workbuddy-connect/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
